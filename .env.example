# Required: Gemini API key from https://aistudio.google.com/apikey
# Server-side only. The browser receives a single-use ephemeral token instead.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_SUMMARY_MODEL=gemini-3.5-flash-lite
# GEMINI_API_VERSION=v1alpha
# GEMINI_VOICE=Aoede
# MAX_CALL_SECONDS=480
# RATE_LIMIT_SESSIONS=8
